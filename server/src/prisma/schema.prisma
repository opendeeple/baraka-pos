generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                Int       @id @default(autoincrement())
  name              String
  address           String?
  phone             String?
  email             String?
  salePrefix        String    @default("INV")
  currentSaleNumber Int       @default(0)
  timezone          String    @default("UTC")
  logoUrl           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  users         User[]
  products      Product[]
  productStocks ProductStock[]
  sales         Sale[]
  sessions      PosSession[]
  contacts      Contact[]
  purchases     Purchase[]
  expenses      Expense[]
  employees     Employee[]
  cashLogs      CashLog[]
  charges       Charge[]
  settings      Setting[]
  devices       Device[]

  @@map("stores")
}

model User {
  id           Int       @id @default(autoincrement())
  syncId       String    @unique @default(uuid())
  storeId      Int
  name         String
  email        String?
  username     String    @unique
  passwordHash String
  role         UserRole  @default(cashier)
  pinCode      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  store    Store      @relation(fields: [storeId], references: [id])
  sessions PosSession[]
  sales    Sale[]

  @@index([storeId, updatedAt])
  @@map("users")
}

enum UserRole {
  super_admin
  admin
  manager
  cashier
}

model Contact {
  id                  Int         @id @default(autoincrement())
  syncId              String      @unique @default(uuid())
  storeId             Int
  name                String
  email               String?
  phone               String?
  whatsapp            String?
  address             String?
  type                ContactType @default(customer)
  balance             Decimal     @default(0) @db.Decimal(12, 2)
  loyaltyPointsBalance Decimal    @default(0) @db.Decimal(12, 2)
  notes               String?
  metaData            Json?
  // Set once the customer taps their one-time t.me/<bot>?start=<syncId> link
  // and messages the bot — Telegram's Bot API can only message a chat the
  // user has initiated, so this stays null (and Telegram sending is skipped)
  // until they've done that.
  telegramChatId      String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  store                  Store                    @relation(fields: [storeId], references: [id])
  sales                  Sale[]
  purchases              Purchase[]
  loyaltyTransactions    LoyaltyPointTransaction[]
  cashLogs               CashLog[]
  paymentTransactions    PaymentTransaction[]
  productBatchesSupplied ProductBatch[]
  messageLogs            MessageLog[]

  @@index([storeId, updatedAt])
  @@map("contacts")
}

enum ContactType {
  customer
  vendor
  both
}

model Collection {
  id             Int            @id @default(autoincrement())
  syncId         String         @unique @default(uuid())
  collectionType CollectionType
  name           String
  slug           String         @unique
  description    String?
  parentId       Int?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  parent   Collection?  @relation("CollectionHierarchy", fields: [parentId], references: [id])
  children Collection[] @relation("CollectionHierarchy")
  products CollectionProduct[]
  productsAsCat Product[] @relation("ProductCategory")
  productsAsBrand Product[] @relation("ProductBrand")

  @@index([updatedAt])
  @@map("collections")
}

enum CollectionType {
  category
  brand
  tag
}

model CollectionProduct {
  id           Int        @id @default(autoincrement())
  collectionId Int
  productId    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId])
  @@map("collection_product")
}

model Product {
  id              Int         @id @default(autoincrement())
  syncId          String      @unique @default(uuid())
  storeId         Int
  name            String
  description     String?
  sku             String?
  barcode         String?
  imageUrl        String?
  unit            String?
  unitsPerPackage Decimal?    @db.Decimal(12, 2)
  categoryId      Int?
  brandId         Int?
  productType     ProductType @default(simple)
  isStockManaged  Boolean     @default(true)
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  alertQuantity   Decimal?    @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(5, 2)
  metaData        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  store       Store              @relation(fields: [storeId], references: [id])
  category    Collection?        @relation("ProductCategory", fields: [categoryId], references: [id])
  brand       Collection?        @relation("ProductBrand", fields: [brandId], references: [id])
  batches     ProductBatch[]
  stocks      ProductStock[]
  collections CollectionProduct[]
  saleItems   SaleItem[]

  @@index([storeId, updatedAt])
  @@map("products")
}

enum ProductType {
  simple
  reload
  service
  combo
}

model ProductBatch {
  id           Int       @id @default(autoincrement())
  syncId       String    @unique @default(uuid())
  productId    Int
  batchNumber  String?
  expiryDate   DateTime?
  cost         Decimal   @default(0) @db.Decimal(12, 2)
  price        Decimal   @default(0) @db.Decimal(12, 2)
  discount     Decimal   @default(0) @db.Decimal(5, 2)
  isActive     Boolean   @default(true)
  isFeatured   Boolean   @default(false)
  vendorId     Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  product    Product        @relation(fields: [productId], references: [id])
  vendor     Contact?       @relation(fields: [vendorId], references: [id])
  stocks     ProductStock[]
  saleItems  SaleItem[]
  purchaseItems PurchaseItem[]
  adjustments QuantityAdjustment[]

  @@index([updatedAt])
  @@map("product_batches")
}

model ProductStock {
  id        Int      @id @default(autoincrement())
  syncId    String   @unique @default(uuid())
  storeId   Int
  productId Int
  batchId   Int
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt

  store   Store        @relation(fields: [storeId], references: [id])
  product Product      @relation(fields: [productId], references: [id])
  batch   ProductBatch @relation(fields: [batchId], references: [id])
  adjustments QuantityAdjustment[]

  @@unique([storeId, productId, batchId])
  @@index([storeId, updatedAt])
  @@map("product_stocks")
}

model Charge {
  id          Int            @id @default(autoincrement())
  syncId      String         @unique @default(uuid())
  storeId     Int
  name        String
  chargeType  ChargeType
  rateType    ChargeRateType
  rateValue   Decimal        @db.Decimal(10, 4)
  description String?
  isActive    Boolean        @default(true)
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, updatedAt])
  @@map("charges")
}

enum ChargeType {
  tax
  service_charge
  delivery_fee
  gratuity
  custom
}

enum ChargeRateType {
  percentage
  fixed
}

model PosSession {
  id                        Int          @id @default(autoincrement())
  syncId                    String       @unique @default(uuid())
  storeId                   Int
  terminalId                String
  userId                    Int
  state                     SessionState @default(opening_control)
  openingBalance            Decimal      @default(0) @db.Decimal(12, 2)
  closingBalanceTheoretical Decimal?     @db.Decimal(12, 2)
  closingBalanceActual      Decimal?     @db.Decimal(12, 2)
  variance                  Decimal?     @db.Decimal(12, 2)
  openedAt                  DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  store    Store    @relation(fields: [storeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  sales    Sale[]
  cashLogs CashLog[]
  expenses Expense[]

  @@index([storeId, updatedAt])
  @@map("pos_sessions")
}

enum SessionState {
  opening_control
  opened
  closing_control
  closed
}

model Sale {
  id                Int           @id @default(autoincrement())
  syncId            String        @unique
  storeId           Int
  sessionId         Int
  contactId         Int?
  userId            Int
  deviceId          Int?
  localReference    String?
  invoiceNumber     String        @unique
  saleType          SaleType      @default(sale)
  referenceId       Int?
  saleDate          DateTime      @default(now()) @db.Date
  saleTime          DateTime      @default(now())
  subtotal          Decimal       @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  totalChargeAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  amountReceived    Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount      Decimal       @default(0) @db.Decimal(12, 2)
  profitAmount      Decimal       @default(0) @db.Decimal(12, 2)
  status            SaleStatus    @default(completed)
  paymentStatus     PaymentStatus @default(fully_paid)
  note              String?
  cartSnapshot      Json?
  metaData          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  store       Store                @relation(fields: [storeId], references: [id])
  session     PosSession           @relation(fields: [sessionId], references: [id])
  contact     Contact?             @relation(fields: [contactId], references: [id])
  user        User                 @relation(fields: [userId], references: [id])
  reference   Sale?                @relation("SaleReturn", fields: [referenceId], references: [id])
  returns     Sale[]               @relation("SaleReturn")
  device      Device?              @relation(fields: [deviceId], references: [id])
  items       SaleItem[]
  payments    PaymentTransaction[]

  @@index([storeId, updatedAt])
  @@map("sales")
}

enum SaleType {
  sale
  return
  quote
}

enum SaleStatus {
  pending
  completed
  refunded
  cancelled
  suspended
}

enum PaymentStatus {
  pending
  partially_paid
  fully_paid
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  syncId      String   @unique @default(uuid())
  saleId      Int
  itemType    ItemType @default(product)
  productId   Int?
  batchId     Int?
  chargeId    Int?
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  freeQuantity Decimal @default(0) @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  flatDiscount Decimal @default(0) @db.Decimal(12, 2)
  isFree      Boolean  @default(false)
  notes       String?
  saleDate    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sale    Sale          @relation(fields: [saleId], references: [id])
  product Product?      @relation(fields: [productId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  @@map("sale_items")
}

enum ItemType {
  product
  charge
}

model PaymentTransaction {
  id                   Int             @id @default(autoincrement())
  syncId               String          @unique @default(uuid())
  saleId               Int?
  storeId              Int
  contactId            Int?
  sessionId            Int?
  transactionDate      DateTime        @default(now())
  amount               Decimal         @db.Decimal(12, 2)
  paymentMethod        PaymentMethod
  transactionType      TransactionType @default(sale)
  chargeState          ChargeState     @default(FULLY_CHARGED)
  paymentTerminalRef   String?
  note                 String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  sale    Sale?    @relation(fields: [saleId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])

  @@map("payment_transactions")
}

enum PaymentMethod {
  Cash
  Card
  Click
  Debt
  BankTransfer
  Credit
  GiftCard
  MobileMoney
  LoyaltyPoints
}

enum TransactionType {
  sale
  return
  cashin
  cashout
  credit
}

enum ChargeState {
  NOT_CHARGED
  PARTIALLY_CHARGED
  FULLY_CHARGED
}

model LoyaltyPointTransaction {
  id          Int          @id @default(autoincrement())
  contactId   Int
  storeId     Int
  points      Decimal      @db.Decimal(12, 2)
  type        LoyaltyType
  description String?
  expiresAt   DateTime?
  referenceId Int?
  createdBy   Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  contact Contact @relation(fields: [contactId], references: [id])

  @@map("loyalty_point_transactions")
}

enum LoyaltyType {
  earn
  redeem
  expire
  manual_adjustment
}

model CashLog {
  id              Int             @id @default(autoincrement())
  syncId          String          @unique @default(uuid())
  sessionId       Int?
  storeId         Int
  contactId       Int?
  transactionDate DateTime        @default(now())
  transactionType CashLogType
  amount          Decimal         @db.Decimal(12, 2)
  source          CashLogSource
  description     String?
  referenceId     Int?
  createdBy       Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  store   Store      @relation(fields: [storeId], references: [id])
  session PosSession? @relation(fields: [sessionId], references: [id])
  contact Contact?   @relation(fields: [contactId], references: [id])

  @@map("cash_logs")
}

enum CashLogType {
  cash_in
  cash_out
}

enum CashLogSource {
  sale
  purchase
  expense
  deposit
  withdrawal
  salary
  cash_drop
  payout
}

model Purchase {
  id            Int            @id @default(autoincrement())
  syncId        String         @unique @default(uuid())
  storeId       Int
  contactId     Int?
  purchaseDate  DateTime       @default(now())
  referenceNo   String?
  totalAmount   Decimal        @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid    Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus  @default(pending)
  status        PurchaseStatus @default(draft)
  note          String?
  createdBy     Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  store   Store    @relation(fields: [storeId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  items   PurchaseItem[]

  @@index([storeId, updatedAt])
  @@map("purchases")
}

enum PurchaseStatus {
  draft
  received
  partial
}

model PurchaseItem {
  id           Int      @id @default(autoincrement())
  syncId       String   @unique @default(uuid())
  purchaseId   Int
  productId    Int?
  batchId      Int?
  description  String
  purchaseDate DateTime @default(now())
  quantity     Decimal  @db.Decimal(12, 2)
  unitPrice    Decimal  @db.Decimal(12, 2)
  unitCost     Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(5, 2)
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchase Purchase      @relation(fields: [purchaseId], references: [id])
  batch    ProductBatch? @relation(fields: [batchId], references: [id])

  @@map("purchase_items")
}

model Expense {
  id          Int      @id @default(autoincrement())
  syncId      String   @unique @default(uuid())
  storeId     Int
  sessionId   Int?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  source      String?
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  store   Store      @relation(fields: [storeId], references: [id])
  session PosSession? @relation(fields: [sessionId], references: [id])

  @@index([storeId, updatedAt])
  @@map("expenses")
}

model Employee {
  id            Int              @id @default(autoincrement())
  storeId       Int
  name          String
  contactNumber String?
  address       String?
  joinedAt      DateTime?
  salary        Decimal?         @db.Decimal(12, 2)
  salaryFreq    SalaryFrequency  @default(monthly)
  role          String?
  status        EmployeeStatus   @default(active)
  gender        String?
  balance       Decimal          @default(0) @db.Decimal(12, 2)
  createdBy     Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  store         Store          @relation(fields: [storeId], references: [id])
  salaryRecords SalaryRecord[]

  @@map("employees")
}

enum SalaryFrequency {
  daily
  weekly
  monthly
}

enum EmployeeStatus {
  active
  inactive
}

model SalaryRecord {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  storeId      Int
  salaryDate   DateTime
  basicSalary  Decimal  @db.Decimal(12, 2)
  allowances   Decimal  @default(0) @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary  Decimal  @db.Decimal(12, 2)
  netSalary    Decimal  @db.Decimal(12, 2)
  remarks      String?
  createdBy    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("salary_records")
}

model QuantityAdjustment {
  id                 Int      @id @default(autoincrement())
  syncId             String   @unique @default(uuid())
  storeId            Int
  batchId            Int
  stockId            Int
  previousQuantity   Decimal  @db.Decimal(12, 2)
  adjustedQuantity   Decimal  @db.Decimal(12, 2)
  reason             String?
  createdBy          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  batch ProductBatch @relation(fields: [batchId], references: [id])
  stock ProductStock @relation(fields: [stockId], references: [id])

  @@index([storeId, updatedAt])
  @@map("quantity_adjustments")
}

model Setting {
  id        Int      @id @default(autoincrement())
  syncId    String   @unique @default(uuid())
  storeId   Int
  metaKey   String
  metaValue Json
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, metaKey])
  @@index([storeId, updatedAt])
  @@map("settings")
}

// Server-managed only — deliberately NOT part of the local-first sync engine.
// Sending a message inherently needs connectivity (there's no offline
// Telegram/SMS), so the desktop app calls the REST endpoints in
// notifications.router.ts directly rather than going through local SQLite +
// the outbox like everything else in this app.
model MessageLog {
  id          Int             @id @default(autoincrement())
  storeId     Int
  contactId   Int
  channel     MessageChannel
  body        String
  status      MessageStatus   @default(sent)
  error       String?
  sentAt      DateTime        @default(now())
  createdBy   Int?

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId, sentAt])
  @@map("message_logs")
}

enum MessageChannel {
  telegram
  sms
}

enum MessageStatus {
  sent
  failed
}

model Device {
  id                Int       @id @default(autoincrement())
  syncId            String    @unique @default(uuid())
  storeId           Int
  name              String
  platform          String
  keyHash           String
  registeredBy      Int?
  lastSeenAt        DateTime?
  lastPulledAt      DateTime?
  invoiceRangeStart Int?
  invoiceRangeEnd   Int?
  invoiceRangeNext  Int?
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store Store  @relation(fields: [storeId], references: [id])
  sales Sale[]

  @@map("devices")
}
