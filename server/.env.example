# Local dev: a local Postgres instance.
# Production (Render): use Supabase's "Session pooler" string (Project >
# Connect > Direct > Session pooler), port 5432 — looks like
# postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Do NOT use the direct db.xxx.supabase.co host: it is IPv6-only and Render
# cannot reach it (build fails with Prisma P1001). The transaction pooler on
# port 6543 also won't work — Prisma migrate needs session semantics. See
# DEPLOYMENT.md for the full walkthrough.
DATABASE_URL="postgresql://postgres:password@localhost:5432/baraka_pos"

# Production: generate real random values (e.g. `openssl rand -base64 32`)
# and set them in the Render dashboard's Environment tab — never commit real
# secrets here or reuse these dev placeholders in production.
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=3001
NODE_ENV=development
SYNC_API_KEY="change-this-sync-api-key"

# Production: the desktop app and future mobile app both call the server via
# a native HTTP client (Electron's main process / React Native), neither of
# which sends a browser Origin header — so this mostly matters if a
# browser-based client (e.g. a future web dashboard) is ever added.
CORS_ORIGIN="http://localhost:5173"
