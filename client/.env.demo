# `--mode demo` builds (dev:demo, build:demo, package:demo, ...): the apps talk
# only to the demo server, which runs the `dev` branch against the demo
# database, and keep their local data in their own folder
# (%APPDATA%\baraka-pos-demo), so they never touch the real store.
VITE_APP_ENV=demo
VITE_SERVER_URL=https://barakapos-demo.onrender.com
