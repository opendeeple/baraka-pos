    "iconv-lite": "^0.6.3",
    "iota-array": "^1.0.0",
    "is-buffer": "^1.1.6",
    "is-typedarray": "^1.0.0",
    "isstream": "^0.1.2",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.2.0",
    "jsbn": "^0.1.1",
    "json-schema": "^0.4.0",
    "json-schema-traverse": "^0.4.1",
    "json-stringify-safe": "^5.0.1",
    "jsonfile": "^6.2.1",
    "jsprim": "^1.4.2",
    "keytar": "^7.9.0",
    "lazy-val": "^1.0.5",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isequal": "^4.5.0",
    "mime-db": "^1.52.0",
    "mime-types": "^2.1.35",
    "ms": "^2.1.3",
    "mutable-buffer": "^2.2.5",
    "ndarray": "^1.0.19",
