    "safer-buffer": "^2.1.2",
    "sax": "^1.6.0",
    "semver": "^7.7.4",
    "sshpk": "^1.18.0",
    "through": "^2.3.8",
    "tiny-typed-emitter": "^2.1.0",
    "tough-cookie": "^2.5.0",
    "tunnel-agent": "^0.6.0",
    "tweetnacl": "^0.14.5",
    "uniq": "^1.0.1",
    "universalify": "^2.0.1",
    "uri-js": "^4.4.1",
    "usb": "^3.0.0",
    "verror": "^1.10.0"
  },
  "optionalDependencies": {
    "@node-usb/usb-win32-x64-msvc": "^3.0.0"
  },
  "devDependencies": {
    "@baraka/app-core": "workspace:*",
    "@baraka/db-schema": "workspace:*",
    "@baraka/shared": "workspace:*",
    "@baraka/sync-engine": "workspace:*",
    "@baraka/ui-tokens": "workspace:*",
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.50.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.400.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.39",
    "prebuild-install": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "recharts": "^2.12.7",
    "serve": "^14.2.6",
    "socket.io-client": "^4.7.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.4.5",
    "uuid": "^10.0.0",
    "vite": "^5.3.3",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.baraka.pos",
    "productName": "BarakaPOS",
    "copyright": "Copyright © 2025 BarakaPOS",
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.{iobj,ipdb,pdb}",
      "!node_modules/better-sqlite3/{deps,src}/**/*",
      "!**/*.js.map"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "BarakaPOS-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BarakaPOS",
      "uninstallDisplayName": "BarakaPOS",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "include": "resources/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns",
      "category": "public.app-category.business"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png",
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "baraka",
      "repo": "baraka-pos-releases"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/escpos-usb/**/*",
      "node_modules/keytar/**/*",
      "node_modules/usb/**/*"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
